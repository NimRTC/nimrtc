# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.c     text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.cmake text eol=lf
*.in    text eol=lf

# Script files
*.sh    text eol=lf
*.py    text eol=lf

# Windows batch scripts must be checked out with CRLF endings.  cmd.exe
# mis-parses an LF-only batch file: it fails to resolve `goto` labels,
# splits quoted paths at spaces, and can loop over the file forever.
# With `* text=auto` alone the working-tree endings follow the local
# core.autocrlf setting, so a clone with core.autocrlf=input produced a
# broken script.
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Documentation
*.md    text eol=lf
*.rst   text eol=lf
*.txt   text eol=lf

# Fuzz corpus seeds
#
# The seeds are checked in as text (see the fuzz corpus section in
# `.gitignore`): binary blobs never enter the repository.  `.hex` is the
# hex-text seed format, `.sdp` the SDP seeds.  Both are LF-normalised
# so the checked-in bytes are identical on every platform -- the
# replay driver hashes nothing, but a CRLF round-trip would still make
# the diff noisy.
*.hex   text eol=lf
*.sdp   text eol=lf

# Configuration
*.json  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf

# Patches (unified diffs must keep LF so `git apply` works on Windows)
*.patch  text eol=lf

# Binary files — do not normalise
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.obj   binary
*.o     binary
*.a     binary
*.lib   binary
