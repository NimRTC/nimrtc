# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.c     text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.cmake text eol=lf
*.in    text eol=lf

# Script files
*.sh    text eol=lf
*.py    text eol=lf

# Documentation
*.md    text eol=lf
*.rst   text eol=lf
*.txt   text eol=lf

# Configuration
*.json  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf

# Binary files — do not normalise
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.obj   binary
*.o     binary
*.a     binary
*.lib   binary
