# Submodules for NimRTC's third-party dependencies.
#
# Every entry below is a REAL submodule: the parent repository tracks
# the path as a gitlink (index mode 160000), so `git submodule update
# --init` fetches it and the tree is stored as a 40-byte pointer
# instead of a checked-in source tree.
#
# The pinned commit for each submodule lives in
# src/third_party/vendor.json and is enforced by tools/check_vendor.py
# in CI.  Update both files together when bumping a pin.
#
# NOTE: webrtc_audio_processing is deliberately NOT listed here.  Its
# source tree is fetched at build time by tools/fetch_webrtc_apm.py
# (it is gitignored and never committed), then patched by
# tools/apply_webrtc_apm_patches.py from the versioned patches under
# src/third_party/webrtc_audio_processing/patches/.  A submodule entry
# would be misleading: there is no gitlink for it in the index, so
# `git submodule update --init` would have nothing to fetch.  Its pinned
# upstream SHA lives in src/third_party/vendor.json like the others.
#
# NOTE: libjuice and mbedtls are NOT listed here either.  Their sources
# are still checked into this repository, so an entry would claim a
# submodule that does not exist in the index.  Their conversion is
# tracked as Phase 3 of docs/plan/vendor-migration.md; the URLs and
# branches are kept at the bottom of this file for that work.

[submodule "src/third_party/wolfssl/src"]
	path = src/third_party/wolfssl/src
	url = https://github.com/wolfSSL/wolfssl.git
	# Pinned: v5.9.2 — see src/third_party/vendor.json
	branch = v5.9.2-stable

[submodule "src/third_party/libopus/src"]
	path = src/third_party/libopus/src
	url = https://github.com/xiph/opus.git
	# Pinned: v1.6.1
	branch = v1.6.1

[submodule "src/third_party/nlohmann_json"]
	path = src/third_party/nlohmann_json
	url = https://github.com/nlohmann/json.git
	# Pinned: v3.11.3 (single-header; submodule is optional)
	branch = v3.11.3

[submodule "src/third_party/googletest"]
	path = src/third_party/googletest
	url = https://github.com/google/googletest.git
	# Pinned: v1.12.0 (v1.12.1 not yet released upstream as of 2026-09-11)
	branch = v1.12.0

[submodule "src/third_party/msquic"]
	path = src/third_party/msquic
	url = https://github.com/NimRTC/msquic.git
	# Pinned: see src/third_party/vendor.json (commit_sha field).
	# Run `git submodule update --init src/third_party/msquic` to fetch.
	# Update vendor.json with the actual SHA after fetching.
	# ADR-014 Criterion 5 (active maintenance: < 180 days old) is verified
	# by interop/v0_14_msquic_spike/ at build time.
	# Fork of microsoft/msquic carrying one NimRTC patch: force the dummy
	# raw datapath, because the Windows XDP SDK is absent in the CI build
	# environment.  The patch is committed on the fork's branch rather
	# than rewritten at configure time, so the submodule working tree
	# stays vendor-clean and the pin is fetchable from a fresh clone.
	branch = nimrtc-patches

[submodule "src/third_party/libsrtp/src"]
	path = src/third_party/libsrtp/src
	url = https://github.com/cisco/libsrtp.git
	# Pinned: 2f82ec0e6e55a18d9cfae2001a4b3fbbc0049da2 (see src/third_party/vendor.json)
	# The checked-in tree was byte-identical to this revision, so no
	# NimRTC-local patch had to be carried over during the conversion.
	branch = main

# ---------------------------------------------------------------------------
# Pending submodule conversions (Phase 3 of docs/plan/vendor-migration.md).
# These paths are tracked as regular files in this repository, so they are
# deliberately left out of the submodule sections above.  The values below
# are the intended settings for the conversion commits.
#
# libsrtp — converted in this repository; see the submodule section
#   above.  The checked-in tree was byte-identical to the pinned revision
#   (2f82ec0e6e55a18d9cfae2001a4b3fbbc0049da2), so it converted
#   directly with no NimRTC-local patch.
#
# libjuice — the checked-in tree carries one NimRTC-local patch on top of
#   the pinned revision (77daa8befd828046169adbb012d8de928bfdcdd4): the
#   patch that stops src/udp.c from setting SO_REUSEADDR/SO_REUSEPORT
#   (so two ICE agents can never share one UDP port) and stops
#   src/conn_mux.c from merging an ephemeral-port agent into an existing
#   mux registry.  The patch has to be preserved (fork or versioned patch
#   file) before the conversion.
#     path   = src/third_party/libjuice/src
#     url    = https://github.com/paullouisageneau/libjuice.git
#     branch = master
#
# mbedtls — archival only, but the checked-in tree inlines the contents of
#   upstream's separate "framework" submodule, so it is not byte-identical
#   to the pinned revision (023aca86208a4f1e602b4098fb46d936adb4657a).
#     path   = src/third_party/mbedtls/src
#     url    = https://github.com/Mbed-TLS/mbedtls.git
#     branch = mbedtls-4.2.0
# ---------------------------------------------------------------------------
[submodule "src/third_party/gmssl/src"]
	path = src/third_party/gmssl/src
	url = https://github.com/guanzhi/GmSSL.git
	# Pinned: v3.2.0 (7c9f02904ef33e59c87b4f16621cc8fd434e7579) — see src/third_party/vendor.json
	# v1.1 X1 (ADR-013 correction): default OFF, opt-in via NIMRTC_ENABLE_DTLS_GMSSL=ON.

# ---------------------------------------------------------------------------
# Remote-desktop plan WP-B — real software codecs.
#
# Both are REAL submodules: the parent repository tracks the path as a
# gitlink (index mode 160000), so `git submodule update --init` fetches
# them.  Upstream ships a Meson build for each, so NimRTC compiles the
# sources through its own CMake wrappers (see
# src/third_party/openh264/CMakeLists.txt and
# src/third_party/dav1d/CMakeLists.txt).
#
# The wrappers build the PORTABLE C path only (no NASM / GAS assembly),
# because neither assembler is guaranteed on the NimRTC build hosts.
# ---------------------------------------------------------------------------
[submodule "src/third_party/openh264/src"]
	path = src/third_party/openh264/src
	url = https://github.com/cisco/openh264.git
	# Pinned: v2.6.0 (652bdb7719f30b52b08e506645a7322ff1b2cc6f) — see src/third_party/vendor.json
	# Real software H.264 encoder + decoder; opt-in via NIMRTC_PLUGINS_OPENH264=ON.
	branch = v2.6.0

[submodule "src/third_party/dav1d/src"]
	path = src/third_party/dav1d/src
	url = https://code.videolan.org/videolan/dav1d.git
	# Pinned: v1.5.1 (42b2b24fb8819f1ed3643aa9cf2a62f03868e3aa) — see src/third_party/vendor.json
	# Real software AV1 decoder (decode only); opt-in via NIMRTC_PLUGINS_DAV1D=ON.
	branch = 1.5.1
