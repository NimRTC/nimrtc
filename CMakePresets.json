{
  "version": 4,
  "configurePresets": [
    {
      "name": "dev",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/install"
    },
    {
      "name": "dev.gcc",
      "hidden": true,
      "inherits": ["dev"],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "dev.clang",
      "hidden": true,
      "inherits": ["dev"],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "dev.msvc",
      "hidden": true,
      "inherits": ["dev"],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev.macos.clang",
      "hidden": true,
      "inherits": ["dev"],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "debug",
      "displayName": "Debug (GCC/Clang, Linux)",
      "description": "Debug build using the host's default Linux toolchain",
      "inherits": ["dev.gcc"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NIMRTC_ASAN": "OFF",
        "NIMRTC_UBSAN": "OFF",
        "NIMRTC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug.clang",
      "displayName": "Debug (Clang, Linux)",
      "description": "Debug build forcing Clang on Linux",
      "inherits": ["dev.clang"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NIMRTC_ASAN": "OFF",
        "NIMRTC_UBSAN": "OFF",
        "NIMRTC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug.msvc",
      "displayName": "Debug (MSVC, Windows)",
      "description": "Debug build using Visual Studio toolchain",
      "inherits": ["dev.msvc"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NIMRTC_ASAN": "OFF",
        "NIMRTC_UBSAN": "OFF",
        "NIMRTC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug.macos",
      "displayName": "Debug (Apple Clang, macOS)",
      "description": "Debug build using Apple Clang on macOS",
      "inherits": ["dev.macos.clang"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NIMRTC_ASAN": "OFF",
        "NIMRTC_UBSAN": "OFF",
        "NIMRTC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug.aarch64",
      "displayName": "Debug (GCC/Clang, aarch64-Linux)",
      "description": "Debug build targeting aarch64-linux-gnu (cross or native arm64)",
      "inherits": ["dev.gcc"],
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_BUILD_TYPE": "Debug",
        "NIMRTC_ASAN": "OFF",
        "NIMRTC_UBSAN": "OFF",
        "NIMRTC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (GCC/Clang, Linux)",
      "description": "Optimised release build using the host's default Linux toolchain",
      "inherits": ["dev.gcc"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NIMRTC_ASAN": "OFF",
        "NIMRTC_UBSAN": "OFF",
        "NIMRTC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release.msvc",
      "displayName": "Release (MSVC, Windows)",
      "description": "Optimised release build using Visual Studio toolchain",
      "inherits": ["dev.msvc"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NIMRTC_ASAN": "OFF",
        "NIMRTC_UBSAN": "OFF",
        "NIMRTC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer (GCC/Clang, Linux)",
      "description": "Debug build with AddressSanitizer enabled",
      "inherits": ["dev.gcc"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NIMRTC_ASAN": "ON",
        "NIMRTC_UBSAN": "OFF",
        "NIMRTC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ubsan",
      "displayName": "UndefinedBehaviourSanitizer (GCC/Clang, Linux)",
      "description": "Debug build with UndefinedBehaviourSanitizer enabled",
      "inherits": ["dev.gcc"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NIMRTC_ASAN": "OFF",
        "NIMRTC_UBSAN": "ON",
        "NIMRTC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (GCC, Linux)",
      "description": "Debug build with coverage instrumentation",
      "inherits": ["dev.gcc"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "NIMRTC_BUILD_TESTS": "ON",
        "NIMRTC_WARNINGS_AS_ERRORS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build: Debug (Linux)",
      "description": "Build the debug preset's binary directory",
      "configurePreset": "debug"
    },
    {
      "name": "debug.clang",
      "displayName": "Build: Debug (Clang, Linux)",
      "configurePreset": "debug.clang"
    },
    {
      "name": "debug.msvc",
      "displayName": "Build: Debug (MSVC, Windows)",
      "configurePreset": "debug.msvc"
    },
    {
      "name": "debug.macos",
      "displayName": "Build: Debug (Apple Clang, macOS)",
      "configurePreset": "debug.macos"
    },
    {
      "name": "debug.aarch64",
      "displayName": "Build: Debug (aarch64-Linux)",
      "configurePreset": "debug.aarch64"
    },
    {
      "name": "release",
      "displayName": "Build: Release (Linux)",
      "configurePreset": "release"
    },
    {
      "name": "release.msvc",
      "displayName": "Build: Release (MSVC, Windows)",
      "configurePreset": "release.msvc"
    },
    {
      "name": "asan",
      "displayName": "Build: AddressSanitizer (Linux)",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "displayName": "Build: UBSan (Linux)",
      "configurePreset": "ubsan"
    },
    {
      "name": "coverage",
      "displayName": "Build: Coverage (Linux)",
      "configurePreset": "coverage"
    }
  ],
  "testPresets": [
    {
      "name": "tests",
      "displayName": "Run all tests (Debug/Linux)",
      "description": "Run all tests via ctest",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "tests.msvc",
      "displayName": "Run all tests (Debug/MSVC)",
      "configurePreset": "debug.msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "tests.macos",
      "displayName": "Run all tests (Debug/macOS)",
      "configurePreset": "debug.macos",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "tests.aarch64",
      "displayName": "Run all tests (Debug/aarch64)",
      "configurePreset": "debug.aarch64",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    }
  ]
}
