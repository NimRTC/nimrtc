# DartConfiguration.tcl — generated by CMake for NimRTC
#
# Required for multi-config generators (Visual Studio, Xcode) so that ctest
# knows which build subdirectory (Debug/Release/…) contains the test binaries.
# Without this file ctest marks every test as NOT_AVAILABLE.
#
# Key names below MUST be the ones CMake's ctest source recognises:
#   SourceDirectory, BuildDirectory, BuildConfiguration (NOT "Configuration").
SourceDirectory: @CMAKE_SOURCE_DIR@
BuildDirectory:  @CMAKE_BINARY_DIR@
# CTest 4.0 recognises "Configuration" (not "BuildConfiguration") for the
# multi-config build subdir name.  Earlier releases accepted either; CMake 4.0
# renamed the canonical key.
Configuration:   @CTEST_CONFIGURATION_TYPE@
