    "control": {
      "enabled": true,
      "stack": "raw-udp-arq",
      "max_p99_ms": 50,
      "freq_hz": 200,
      "reliability": "reliable_ordered",
      "ttl_ms": 100
    }
  },
  "video": {
    "codec_name": "",
    "codec_preference": [
      "av1",
      "h265",
      "h264"
    ],
    "codec_backend": "auto",
    "content_type": "screen",
    "ladder_mode": "quality",
    "resolution_floor": [
      1280,
      720
    ],
    "pixel_format": "i420",
    "color_range": "full",
    "color_matrix": "bt709"
  }
